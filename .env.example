APP_NAME="BokingYuk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta

# ─── URL Aplikasi ───────────────────────────────────────────
# Development : http://localhost:8000
# Production  : https://bokingyuk.example.com
APP_URL=http://localhost:8000

# ─── Database ───────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sport_booking
DB_USERNAME=root
DB_PASSWORD=

# ─── Storage ────────────────────────────────────────────────
# Jalankan: php artisan storage:link
# Gambar lapangan tersimpan di storage/app/public/fields/

# ─── Midtrans (Payment Gateway) ─────────────────────────────
# Daftar di: https://dashboard.midtrans.com
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_IS_PRODUCTION=false

# ─── WhatsApp (Opsional) ─────────────────────────────────────
FONNTE_TOKEN=

# ─── Mobile API Base URL ─────────────────────────────────────
# URL ini digunakan sebagai nilai QR Code untuk mobile check-in.
# Pastikan sama dengan APP_URL.
# Endpoint: {APP_URL}/api/mobile/checkin/{qr_token}

# ─── Google OAuth (Socialite) ────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Aktifkan"Google+ API" / "Google Identity" lalu buat OAuth 2.0 Client ID

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback